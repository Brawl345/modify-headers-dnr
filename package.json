{
  "name": "modify-headers-dnr",
  "description": "Modify request and response headers through the DeclarativeNetRequest API",
  "version": "3.1.0",
  "author": "Brawl345",
  "license": "Unlicense",
  "repository": {
    "url": "https://github.com/Brawl345/modify-headers-dnr"
  },
  "type": "module",
  "keywords": [
    "browser",
    "http",
    "declarativenetrequest"
  ],
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "lint:types": "wxt prepare && vue-tsc --noEmit",
    "lint:code": "biome lint",
    "lint:code-fix": "biome lint --fix",
    "format": "biome format --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "tsx scripts/release.ts"
  },
  "dependencies": {
    "sortablejs": "1.15.7",
    "vue": "3.5.35"
  },
  "overrides": {
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1",
    "shell-quote": ">=1.8.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/chrome": "0.1.43",
    "@types/sortablejs": "1.15.9",
    "@vue/test-utils": "2.4.11",
    "@wxt-dev/module-vue": "1.0.3",
    "happy-dom": "20.10.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "vue-tsc": "3.3.4",
    "wxt": "0.20.26"
  }
}
